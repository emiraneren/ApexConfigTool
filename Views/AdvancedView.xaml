<UserControl x:Class="ApexConfigTool.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ApexConfigTool.Services"
             xmlns:views="clr-namespace:ApexConfigTool.Views">

    <Grid Margin="34">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:PageHeader Badge="AD"
                          Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AdvTitle]}"
                          Subtitle="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AdvSubtitle]}"/>

        <TabControl Grid.Row="1">

            <TabItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AdvInspectorTab]}">
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchBox" Height="38" TextChanged="SearchBox_TextChanged"/>
                            <Button Grid.Column="1"
                                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AdvRefresh]}"
                                    Width="90" Margin="10,0,0,0" Click="RefreshButton_Click"/>
                            <TextBlock x:Name="SettingCountText" Grid.Column="2" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="14,0,0,0"/>
                        </Grid>

                        <DataGrid x:Name="SettingsGrid" Grid.Row="1"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Setting}" Width="*">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewColSetting]}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTextColumn Binding="{Binding Value}" Width="230">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewColNew]}"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AdvRawEditorTab]}">
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="RawEditor" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Cascadia Mono" FontSize="12.5" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AdvReload]}"
                                    Width="90" Margin="0,0,8,0" Click="ReloadRawButton_Click"/>
                            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AdvSave]}"
                                    Width="90" Style="{StaticResource PrimaryButtonStyle}" Click="SaveRawButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

    </Grid>

</UserControl>
