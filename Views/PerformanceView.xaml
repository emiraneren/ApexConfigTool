<UserControl x:Class="ApexConfigTool.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ApexConfigTool.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfTitle]}"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,28"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Height="96" Style="{StaticResource PresetButtonStyle}" Click="CompetitiveButton_Click">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfCompetitive]}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfCompetitiveShort]}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="0" Grid.Column="2" Height="96" Style="{StaticResource PresetButtonStyle}" Click="MaximumFpsButton_Click">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfMaxFps]}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfMaxFpsShort]}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="0" Height="96" Style="{StaticResource PresetButtonStyle}" Click="BalancedButton_Click">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfBalanced]}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfBalancedShort]}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Row="2" Grid.Column="2" Height="96" Style="{StaticResource PresetButtonStyle}" Click="QualityButton_Click">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfQuality]}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfQualityShort]}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfSelectedPreset]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="SelectedPresetText"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PerfCustom]}"
                                   FontSize="21" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="PresetDescriptionText" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="9" Height="9" Background="{StaticResource AccentBrush}"
                            CornerRadius="5" VerticalAlignment="Center" Margin="20,0,4,0"/>
                </Grid>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
