<UserControl x:Class="ApexConfigTool.Views.AutoexecView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ApexConfigTool.Services"
             xmlns:views="clr-namespace:ApexConfigTool.Views">

    <UserControl.Resources>
        <Style x:Key="KeepItem" TargetType="ComboBoxItem">
            <Setter Property="Content" Value="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonKeepCurrent]}"/>
            <Setter Property="Tag" Value="__KEEP__"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <views:PageHeader Badge="AE"
                              Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoTitle]}"
                              Subtitle="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoSubtitle]}"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoInstallation]}"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoLauncher]}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,15,0,3"/>
                        <TextBlock x:Name="LauncherText" Text="—" FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoAutoexec]}"
                                   Style="{StaticResource MutedTextStyle}" Margin="0,15,0,3"/>
                        <TextBlock x:Name="AutoexecStateText" Text="—" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="25,0,0,0">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoGameFolder]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="GamePathText" Text="—" TextWrapping="Wrap" Margin="0,4,0,12"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoConfigPath]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="AutoexecPathText" Text="—" TextWrapping="Wrap" Margin="0,4,0,14"/>

                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoOpenCfgFolder]}"
                                Width="150" HorizontalAlignment="Left" Click="OpenCfgFolderButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoFov]}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoFovLabel]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="FovCombo" Margin="0,5,0,14">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="70" Tag="1.00"/>
                            <ComboBoxItem Content="90" Tag="1.27"/>
                            <ComboBoxItem Content="104" Tag="1.485714"/>
                            <ComboBoxItem Content="110" Tag="1.55"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoFovAdvanced]}" Tag="1.70"/>
                        </ComboBox>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoAbilityFovScaling]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="AbilityFovCombo">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonDisabled]}" Tag="1"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonDefault]}" Tag="0"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoFrameRate]}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoGameLimit]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBox x:Name="FpsCapBox" Text="180" Margin="0,5,0,14"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoLobbyLimit]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBox x:Name="LobbyFpsCapBox" Text="60"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoInput]}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoRawMouseInput]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="RawInputCombo" Margin="0,5,0,14">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonOn]}" Tag="1"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonOff]}" Tag="0"/>
                        </ComboBox>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoMouseAcceleration]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="MouseAccelerationCombo">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonDisabled]}" Tag="0"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonEnabled]}" Tag="1"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoEffects]}"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoFilmGrain]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="FilmGrainCombo" Margin="0,5,0,12">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonOff]}" Tag="0"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonOn]}" Tag="1"/>
                        </ComboBox>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoAdsDof]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="AdsDofCombo" Margin="0,5,0,12">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonOff]}" Tag="0"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonOn]}" Tag="1"/>
                        </ComboBox>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoSprintViewShake]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="ViewShakeCombo" Margin="0,5,0,12">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonMinimal]}" Tag="1"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonDefault]}" Tag="0"/>
                        </ComboBox>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoModelDecals]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="ModelDecalsCombo" Margin="0,5,0,12">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonOff]}" Tag="0"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[CommonOn]}" Tag="1"/>
                        </ComboBox>

                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoCheapWater]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox x:Name="CheapWaterCombo">
                            <ComboBoxItem Style="{StaticResource KeepItem}"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OptOptimized]}" Tag="1"/>
                            <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[OptNormal]}" Tag="0"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoAutoexecFile]}"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>
                    <WrapPanel>
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoReload]}"
                                Width="90" Margin="0,0,8,8" Click="ReloadButton_Click"/>
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoBackup]}"
                                Width="90" Margin="0,0,8,8" Click="BackupButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoLaunchOptions]}"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>
                    <TextBox x:Name="LaunchOptionsBox" IsReadOnly="True"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoCopy]}"
                            Width="90" HorizontalAlignment="Left" Margin="0,12,0,0" Click="CopyLaunchOptionsButton_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoRawAutoexec]}"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>
                    <TextBox x:Name="RawEditor" Height="320" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Cascadia Mono" FontSize="12.5" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AutoSaveRawFile]}"
                            Width="130" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveRawButton_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
