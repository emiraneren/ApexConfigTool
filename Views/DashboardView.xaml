<UserControl x:Class="ApexConfigTool.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ApexConfigTool.Services"
             xmlns:views="clr-namespace:ApexConfigTool.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <views:PageHeader Badge="DB"
                              Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashTitle]}"
                              Subtitle="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashSubtitle]}"/>

            <!-- Ates efektli marka yazisi: dikey alevli renk gecisi + nabiz gibi atan turuncu parlama. -->
            <Border CornerRadius="16"
                    Margin="0,0,0,22"
                    Padding="0,22"
                    Background="#12100D0A">

                <TextBlock Text="Decipline"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Black, Segoe UI"
                           FontSize="58"
                           FontWeight="Black"
                           FontStyle="Italic">

                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#B8210F" Offset="0"/>
                            <GradientStop Color="#FF7A1E" Offset="0.45"/>
                            <GradientStop Color="#FFC24D" Offset="0.75"/>
                            <GradientStop Color="#FFEFC2" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>

                    <TextBlock.Effect>
                        <DropShadowEffect x:Name="FireGlow"
                                          Color="#FF7A1E"
                                          Direction="0"
                                          ShadowDepth="0"
                                          BlurRadius="18"
                                          Opacity="0.85"/>
                    </TextBlock.Effect>

                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="FireGlow"
                                                     Storyboard.TargetProperty="BlurRadius"
                                                     From="12" To="30"
                                                     Duration="0:0:1.1"
                                                     AutoReverse="True"
                                                     RepeatBehavior="Forever"/>
                                    <DoubleAnimation Storyboard.TargetName="FireGlow"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.65" To="1"
                                                     Duration="0:0:1.1"
                                                     AutoReverse="True"
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>

                </TextBlock>

            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashResolution]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="ResolutionText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashFov]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="FovText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashFpsLimit]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="FpsText" Text="—" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashApex]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="ApexStateText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashLauncher]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="LauncherText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashProtection]}"
                                   Style="{StaticResource MutedTextStyle}"/>
                        <TextBlock x:Name="ReadOnlyText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DashVideoConfig]}"
                               Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock x:Name="ConfigPathText" Text="—" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
