<UserControl x:Class="ApexConfigTool.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ApexConfigTool.Services">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfTitle]}"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,28"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfSaveProfile]}"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>
                    <TextBox x:Name="ProfileNameBox" Height="38"
                             Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfNamePlaceholder], Mode=OneTime}"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfSaveCurrent]}"
                            Width="180" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Style="{StaticResource PrimaryButtonStyle}" Click="SaveProfileButton_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfSavedProfiles]}"
                               Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>
                    <ListBox x:Name="ProfileList" Height="300" DisplayMemberPath="DisplayText"/>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfLoad]}"
                                Width="90" Margin="0,0,8,8" Style="{StaticResource PrimaryButtonStyle}" Click="LoadProfileButton_Click"/>
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfDelete]}"
                                Width="90" Margin="0,0,8,8" Click="DeleteProfileButton_Click"/>
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfRefresh]}"
                                Width="90" Margin="0,0,8,8" Click="RefreshButton_Click"/>
                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[ProfOpenFolder]}"
                                Width="120" Margin="0,0,8,8" Click="OpenProfilesFolderButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
