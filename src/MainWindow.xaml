<Window x:Class="ApexConfigTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ApexConfigTool.Services"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AppTitle]}"
        Icon="AppIcon.ico"
        Width="1200"
        Height="780"
        MinWidth="1040"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="222"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kenar çubuğu -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <Grid Margin="14">

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Navigasyon alani tasarsa bile alt kisim (dil/durum) her zaman
                     tam gorunur kalsin diye kaydirilabilir alana sarildi. -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Logo -->
                    <Grid Margin="6,10,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="34" Height="34" Background="{StaticResource AccentBrush}"
                                CornerRadius="10" VerticalAlignment="Center">
                            <TextBlock Text="A" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1A1206"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[AppTitle]}"
                                   FontFamily="Segoe UI Variable Display" FontSize="19" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Navigasyon -->

                    <RadioButton x:Name="NavDashboard" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavDashboard]}" Tag="DB"
                                 GroupName="Navigation" IsChecked="True"
                                 Style="{StaticResource NavRadioButtonStyle}" Click="DashboardButton_Click"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavGroupSettings]}" Style="{StaticResource NavGroupCaptionStyle}"/>

                    <RadioButton x:Name="NavDisplay" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavDisplay]}" Tag="DS"
                                 GroupName="Navigation" Style="{StaticResource NavRadioButtonStyle}" Click="DisplayButton_Click"/>

                    <RadioButton x:Name="NavGraphics" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavGraphics]}" Tag="GR"
                                 GroupName="Navigation" Style="{StaticResource NavRadioButtonStyle}" Click="GraphicsButton_Click"/>

                    <RadioButton x:Name="NavShadows" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavShadows]}" Tag="SH"
                                 GroupName="Navigation" Style="{StaticResource NavRadioButtonStyle}" Click="ShadowsButton_Click"/>

                    <RadioButton x:Name="NavPerformance" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavPerformance]}" Tag="PF"
                                 GroupName="Navigation" Style="{StaticResource NavRadioButtonStyle}" Click="PerformanceButton_Click"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavGroupGame]}" Style="{StaticResource NavGroupCaptionStyle}"/>

                    <RadioButton x:Name="NavAutoexec" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavAutoexec]}" Tag="AE"
                                 GroupName="Navigation" Style="{StaticResource NavRadioButtonStyle}" Click="AutoexecButton_Click"/>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavGroupManage]}" Style="{StaticResource NavGroupCaptionStyle}"/>

                    <RadioButton x:Name="NavProfiles" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavProfiles]}" Tag="PR"
                                 GroupName="Navigation" Style="{StaticResource NavRadioButtonStyle}" Click="ProfilesButton_Click"/>

                    <RadioButton x:Name="NavBackups" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavBackups]}" Tag="BK"
                                 GroupName="Navigation" Style="{StaticResource NavRadioButtonStyle}" Click="BackupsButton_Click"/>

                    <RadioButton x:Name="NavAdvanced" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[NavAdvanced]}" Tag="AD"
                                 GroupName="Navigation" Style="{StaticResource NavRadioButtonStyle}" Click="AdvancedButton_Click"/>

                </StackPanel>
                </ScrollViewer>

                <!-- Alt -->
                <StackPanel Grid.Row="1" Margin="6,12">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left">
                            <TextBlock x:Name="ApexProcessText" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"/>
                        </Border>
                    </StackPanel>

                    <UniformGrid Rows="2" Columns="2" Margin="0,0,0,8">
                        <Button x:Name="LangTrButton" Content="TR" Style="{StaticResource LanguageToggleButtonStyle}"
                                Margin="0,0,6,6" Click="LangTrButton_Click"/>
                        <Button x:Name="LangEnButton" Content="EN" Style="{StaticResource LanguageToggleButtonStyle}"
                                Margin="0,0,0,6" Click="LangEnButton_Click"/>
                        <Button x:Name="LangZhButton" Content="中文" Style="{StaticResource LanguageToggleButtonStyle}"
                                Margin="0,0,6,0" Click="LangZhButton_Click"/>
                        <Button x:Name="LangRuButton" Content="RU" Style="{StaticResource LanguageToggleButtonStyle}"
                                Click="LangRuButton_Click"/>
                    </UniformGrid>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[VersionLabel]}"
                               Foreground="{StaticResource FaintTextBrush}" FontSize="10.5" Margin="10,0,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- İçerik -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="MainContent" Grid.Row="0"/>

            <!-- Bağlamsal alt eylem çubuğu: yalnızca video/autoexec ayarı barındıran
                 sayfalarda görünür (Profiller/Yedekler/Gelişmiş kendi eylemlerini içerir). -->
            <Border x:Name="ActionBar"
                    Grid.Row="1"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">

                <Grid Margin="22,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[BtnBackup]}"
                                Width="90" Height="40" Margin="4,0" Click="BackupButton_Click"/>

                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[BtnRestore]}"
                                Width="90" Height="40" Margin="4,0" Click="RestoreButton_Click"/>

                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[BtnApply]}"
                                Width="105" Height="40" Margin="4,0"
                                Style="{StaticResource AccentOutlineButtonStyle}" Click="ApplyButton_Click"/>

                        <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[BtnApplyLaunch]}"
                                Width="155" Height="40" Margin="4,0"
                                Style="{StaticResource PrimaryButtonStyle}" Click="ApplyLaunchButton_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
