<UserControl x:Class="ApexConfigTool.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ApexConfigTool.Services"
             xmlns:views="clr-namespace:ApexConfigTool.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="34">

            <views:PageHeader Badge="DS"
                              Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DisplayTitle]}"
                              Subtitle="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DisplaySubtitle]}"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DisplayResolution]}"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,15"/>

                    <ComboBox x:Name="ResolutionCombo" SelectionChanged="ResolutionCombo_SelectionChanged">
                        <ComboBoxItem Content="1920 × 1080 · 16:9" Tag="1920x1080"/>
                        <ComboBoxItem Content="1728 × 1080 · 16:10" Tag="1728x1080"/>
                        <ComboBoxItem Content="1440 × 1080 · 4:3" Tag="1440x1080"/>
                        <ComboBoxItem Content="1280 × 1024 · 5:4" Tag="1280x1024"/>
                        <ComboBoxItem Content="1280 × 960 · 4:3" Tag="1280x960"/>
                        <ComboBoxItem Content="1080 × 1080 · 1:1" Tag="1080x1080"/>
                        <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DisplayCustomResolution]}" Tag="custom"/>
                    </ComboBox>

                    <StackPanel x:Name="CustomResolutionPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBox x:Name="CustomWidthBox" Width="125" Height="38" Text="1280"/>
                        <TextBlock Text="×" FontSize="18" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0"/>
                        <TextBox x:Name="CustomHeightBox" Width="125" Height="38" Text="960"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DisplayOptions]}"
                               Style="{StaticResource SectionTitleStyle}"
                               Margin="0,0,0,10"/>

                    <CheckBox x:Name="FullscreenCheck"
                              Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DisplayFullscreen]}"/>

                    <CheckBox x:Name="ReadOnlyCheck"
                              Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[DisplayProtectFile]}"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
