<Window x:Class="ApexConfigTool.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ApexConfigTool.Services"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewTitle]}"
        Width="820"
        Height="560"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewTitle]}"
                       Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedTextBrush}" FontSize="12.5" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid x:Name="ChangesGrid"
                      BorderThickness="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Source}" Width="90">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewColSource]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Setting}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewColSetting]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding OldValue}" Width="150">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewColCurrent]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding NewValue}" Width="150">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewColNew]}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewCancel]}"
                    Width="90" Height="40" HorizontalAlignment="Left" Click="CancelButton_Click"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewApply]}"
                        Width="100" Height="40" Margin="4,0" Style="{StaticResource AccentOutlineButtonStyle}" Click="ApplyButton_Click"/>
                <Button Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=[PreviewApplyLaunch]}"
                        Width="150" Height="40" Margin="4,0" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyLaunchButton_Click"/>
            </StackPanel>
        </Grid>

    </Grid>

</Window>
